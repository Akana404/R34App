# rule34.xxx API credentials — generate them while logged in at
# rule34.xxx under My Account → Options → API Access Credentials,
# then copy this file to .env and fill the values in.
API_KEY=
USER_ID=

# Optional: allow opening the dev server from another device on your LAN,
# e.g. ALLOWED_DEV_ORIGIN=192.168.1.50
#ALLOWED_DEV_ORIGIN=

# Optional: where the SQLite file holding likes, dismissals, seen posts,
# seed/blocked tags and tag metadata lives. Relative paths resolve from the
# project root. This file is the backup — copy it to keep your data.
#DB_PATH=data/r34-browser.sqlite
